-- BADGE ASSIST: ownership is verified with Roblox; touching a target is not success by itself.
local BadgeUnlocker: { [string]: any } = { run = nil, entries = {
    { name = "The Weight of the World", id = 2124547904 },
    { name = "Crab Rave", id = 2124626480 },
    { name = "Visited Every Station", id = 2129052412 },
    { name = "Bird Guide", id = 222204627316850 },
    { name = "Pier Pressure", id = 3966841140308429 },
} }
state.badgeUnlocker = BadgeUnlocker
function BadgeUnlocker.check(run, changingStation)
    assert(state.alive and BadgeUnlocker.run == run and not run.cancelled, "Badge attempt cancelled.")
    assert(not state.enabled and not AutoFarm.enabled, "Badge attempt stopped because train automation started.")
    if run.character and not changingStation then
        local player = game:GetService("Players").LocalPlayer
        local humanoid = run.character:FindFirstChildOfClass("Humanoid")
        assert(player.Character == run.character and humanoid and humanoid.Health > 0, "Badge attempt stopped after character changed.")
    end
end
function BadgeUnlocker.wait(run, seconds)
    local finish = os.clock() + seconds
    repeat
        BadgeUnlocker.check(run)
        task.wait(math.min(0.2, math.max(0, finish - os.clock())))
    until os.clock() >= finish
    BadgeUnlocker.check(run)
end
function BadgeUnlocker.owned(entry)
    local service = game:GetService("BadgeService")
    local player = game:GetService("Players").LocalPlayer
    local ok, value = pcall(service.UserHasBadgeAsync, service, player.UserId, entry.id)
    if not ok then return nil end
    return value == true
end
function BadgeUnlocker.update(message)
    setthreadidentity(8)
    if not state.alive then return end
    log(message)
    notify(message)
end
function BadgeUnlocker.report(run, entry, result)
    run.results[entry.name] = result
    BadgeUnlocker.update(entry.name .. ": " .. result)
end
function BadgeUnlocker.prepare(run)
    local player = game:GetService("Players").LocalPlayer
    local loadModule: any = require
    local root: any = game:GetService("ReplicatedStorage"):FindFirstChild("Modules")
    if not player.Team or player.Team.Name ~= "Passengers" then
        assert(not player.Character, "Return to the menu and select Passenger before attempting badges.")
        loadModule(root.Gui.GuiInteraction).SelectRole("Passengers")
        BadgeUnlocker.check(run)
    end
    if not player.Character then
        local result = loadModule(root.Communication).GetFunction("SpawnPlayer"):Invoke("LlynFrontSpawn")
        BadgeUnlocker.check(run)
        assert(result == true, "Passenger spawn was rejected: " .. tostring(result))
        local finish = os.clock() + 10
        while not player.Character and os.clock() < finish do BadgeUnlocker.wait(run, 0.2) end
        assert(player.Character, "Passenger character did not load.")
        loadModule(root.Gui.GuiInteraction).HideMenu()
    end
    BadgeUnlocker.check(run)
    run.character = player.Character
    run.root = assert(run.character:FindFirstChild("HumanoidRootPart"), "Character root is unavailable.")
    run.origin = run.character:GetPivot()
end
function BadgeUnlocker.move(run, position)
    BadgeUnlocker.check(run)
    local player = game:GetService("Players").LocalPlayer
    if workspace.StreamingEnabled then pcall(player.RequestStreamAroundAsync, player, position, 3) end
    BadgeUnlocker.check(run)
    run.character:PivotTo(CFrame.new(position))
    run.root.AssemblyLinearVelocity = Vector3.zero
    run.root.AssemblyAngularVelocity = Vector3.zero
    BadgeUnlocker.wait(run, 1)
end
function BadgeUnlocker.touch(run, entry, modelName, position)
    BadgeUnlocker.move(run, position)
    local folder = workspace:FindFirstChild("BadgeGivers")
    local finish = os.clock() + 8
    local model = folder and folder:FindFirstChild(modelName)
    while not model and os.clock() < finish do
        BadgeUnlocker.wait(run, 0.5)
        model = folder and folder:FindFirstChild(modelName)
    end
    assert(model, entry.name .. " target did not stream in.")
    local touched = false
    for _, part in ipairs(model:GetDescendants()) do
        if part:IsA("BasePart") and part:FindFirstChildOfClass("TouchTransmitter") then
            BadgeUnlocker.check(run)
            if type(firetouchinterest) == "function" then
                -- Real uses 1/true for touch begin and 0/false for touch end.
                firetouchinterest(run.root, part, true)
                local waited, waitError = pcall(BadgeUnlocker.wait, run, 0.15)
                pcall(firetouchinterest, run.root, part, false)
                if not waited then error(waitError, 0) end
            else
                BadgeUnlocker.move(run, part.Position + Vector3.new(0, 3, 0))
            end
            touched = true
        end
    end
    assert(touched, entry.name .. " has no loaded touch target.")
    BadgeUnlocker.wait(run, 12) -- UserHasBadgeAsync can briefly cache the pre-attempt result.
    BadgeUnlocker.report(run, entry, BadgeUnlocker.owned(entry) and "Unlocked" or "Attempted; award not confirmed")
end
function BadgeUnlocker.music(run, entry)
    local loadModule: any = require
    local root: any = game:GetService("ReplicatedStorage"):FindFirstChild("Modules")
    local music = loadModule(root.Music)
    local data = loadModule(root.ClientData)
    local communication = loadModule(root.Communication)
    local saved = false
    BadgeUnlocker.report(run, entry, "Saving Crab Rave in game settings")
    for attempt = 1, 3 do
        BadgeUnlocker.check(run)
        music.UpdateMenuMusic("crab-rave")
        data.PushPreferenceChanges() -- This function logs failures without returning success.
        BadgeUnlocker.check(run)
        local ok, preferences = communication.GetFunction("GetPreferences"):Invoke()
        BadgeUnlocker.check(run)
        saved = ok == true and type(preferences) == "table" and type(preferences.audio) == "table"
            and preferences.audio.menuMusicSlug == "crab-rave"
        if saved then break end
        BadgeUnlocker.report(run, entry, "Settings save not confirmed (attempt " .. attempt .. "/3)")
        if attempt < 3 then BadgeUnlocker.wait(run, 2) end
    end
    assert(saved, "Crab Rave settings did not save on the server; try again later.")
    BadgeUnlocker.report(run, entry, "Settings saved; waiting for badge confirmation")
    -- BadgeService may cache the ownership result from before the preference was saved.
    BadgeUnlocker.wait(run, 12)
    BadgeUnlocker.report(run, entry, BadgeUnlocker.owned(entry) and "Unlocked"
        or "Settings saved on server; badge award not confirmed")
end

function BadgeUnlocker.stationLocations()
    local folder = game:GetService("ReplicatedStorage"):FindFirstChild("SpawnLocations")
    assert(folder, "Passenger spawn metadata is unavailable.")
    local locations = {}
    for _, station in ipairs(folder:GetChildren()) do
        local name, points = station:FindFirstChild("PrettyName"), station:FindFirstChild("Locations")
        if name and name:IsA("StringValue") and points then
            local candidates = points:GetChildren()
            table.sort(candidates, function(a, b) return a.Name < b.Name end)
            for _, point in ipairs(candidates) do
                local hidden = point:FindFirstChild("Hidden")
                if point:IsA("StringValue") and point.Value ~= ""
                    and not (hidden and hidden:IsA("BoolValue") and hidden.Value) then
                    table.insert(locations, { name = name.Value, slug = point.Value })
                    break
                end
            end
        end
    end
    table.sort(locations, function(a, b) return a.name < b.name end)
    assert(#locations > 0, "No accessible Passenger spawn locations are available.")
    return locations
end
function BadgeUnlocker.stationWait(run, predicate, timeout, message)
    local finish = os.clock() + timeout
    repeat
        -- Only our deliberate station respawn may replace the character.
        -- Cancellation and train-automation guards still apply throughout.
        BadgeUnlocker.check(run, true)
        if predicate() then return end
        task.wait(0.1)
    until os.clock() >= finish
    error(message, 0)
end
function BadgeUnlocker.spawnStation(run, station)
    BadgeUnlocker.check(run, true)
    local player = game:GetService("Players").LocalPlayer
    assert(player.Team and player.Team.Name == "Passengers", "Station tour requires the Passenger role.")
    local loadModule: any = require
    local root: any = game:GetService("ReplicatedStorage"):FindFirstChild("Modules")
    local client = loadModule(root.ClientModule)
    local gui = loadModule(root.Gui.GuiInteraction)
    local world = loadModule(root.WorldInteraction)
    BadgeUnlocker.stationWait(run, function() return not client.GetBusy() end, 10, "SCR is busy; Passenger spawn was not requested.")
    if player.Character then world.DestroyCharacter() end
    BadgeUnlocker.stationWait(run, function() return player.Character == nil end, 5, "Previous Passenger character did not despawn.")
    -- DestroyCharacter sends a native event; allow the server to process it before SpawnPlayer.
    local settle = os.clock() + 0.4
    BadgeUnlocker.stationWait(run, function() return os.clock() >= settle end, 2, "Character transition timed out.")
    local result = loadModule(root.Communication).GetFunction("SpawnPlayer"):Invoke(station.slug)
    BadgeUnlocker.check(run, true)
    assert(result == true, station.name .. " spawn rejected: " .. tostring(result))
    BadgeUnlocker.stationWait(run, function()
        local character = player.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        return character and character:FindFirstChild("HumanoidRootPart") and humanoid and humanoid.Health > 0
    end, 12, station.name .. " Passenger character did not load.")
    run.replacedCharacter = true
    run.character = player.Character
    run.root = run.character:FindFirstChild("HumanoidRootPart")
    gui.HideMenu()
    BadgeUnlocker.wait(run, 3)
end
function BadgeUnlocker.stations(run, entry)
    local locations = BadgeUnlocker.stationLocations()
    local visited, failed, consecutiveFailures = 0, {}, 0
    run.visitedStations = {}
    for index, station in ipairs(locations) do
        BadgeUnlocker.check(run, true)
        setthreadidentity(8)
        BadgeUnlocker.update(string.format("Visiting station %d/%d - %s", index, #locations, station.name))
        local success, failure
        for attempt = 1, 2 do
            run.station = { name = station.name, index = index, total = #locations, attempt = attempt }
            success, failure = pcall(BadgeUnlocker.spawnStation, run, station)
            BadgeUnlocker.check(run, true)
            if success then break end
            setthreadidentity(8)
            BadgeUnlocker.update(station.name .. " visit attempt " .. attempt .. " failed: " .. tostring(failure))
        end
        if success then
            visited += 1; consecutiveFailures = 0
            table.insert(run.visitedStations, station.name)
            BadgeUnlocker.update(string.format("Visited station %d/%d - %s", index, #locations, station.name))
        else
            consecutiveFailures += 1
            table.insert(failed, station.name)
            if consecutiveFailures >= 3 then error("Station tour stopped after three consecutive spawn failures: " .. tostring(failure), 0) end
        end
    end
    BadgeUnlocker.check(run)
    BadgeUnlocker.wait(run, 12)
    local result = BadgeUnlocker.owned(entry) and "Unlocked"
        or string.format("Visited %d/%d accessible station spawns; award not confirmed (training Briefing Room may still be required)", visited, #locations)
    if #failed > 0 then result ..= "; failed: " .. table.concat(failed, ", ") end
    BadgeUnlocker.report(run, entry, result)
end
function BadgeUnlocker.birds(run, entry)
    local loadModule: any = require
    local root: any = game:GetService("ReplicatedStorage"):FindFirstChild("Modules")
    local shared = loadModule(root.SharedConfig).LLYN_BADGE
    BadgeUnlocker.move(run, Vector3.new(45926.043, 9.161, -15084.813))
    local target
    local finish = os.clock() + 8
    repeat
        for _, part in ipairs(game:GetService("CollectionService"):GetTagged(shared.PART_TAG)) do
            if part:IsA("BasePart") then target = part; break end
        end
        if not target then BadgeUnlocker.wait(run, 0.5) end
    until target or os.clock() >= finish
    assert(target, "Bird Guide target did not stream in.")
    local ray = RaycastParams.new()
    ray.FilterType = Enum.RaycastFilterType.Exclude
    ray.FilterDescendantsInstances = { run.character }
    local groundRay = RaycastParams.new()
    groundRay.FilterType = Enum.RaycastFilterType.Exclude
    groundRay.FilterDescendantsInstances = { run.character }
    groundRay.RespectCanCollide = true
    local humanoid = run.character:FindFirstChildOfClass("Humanoid")
    local standingHeight = run.root.Size.Y / 2 + (humanoid and humanoid.HipHeight or 2) + 0.1
    local vantage
    for _, distance in ipairs({ 18, 28, 45 }) do
        for _, direction in ipairs({ target.CFrame.LookVector, target.CFrame.RightVector,
            -target.CFrame.LookVector, -target.CFrame.RightVector }) do
            local candidate = target.Position + direction * distance
            local floor = workspace:Raycast(candidate + Vector3.new(0, 6, 0), Vector3.new(0, -80, 0), groundRay)
            if floor then
                candidate = floor.Position + Vector3.new(0, standingHeight, 0)
                local cameraPosition = candidate + Vector3.new(0, 3, 0)
                local hit = workspace:Raycast(cameraPosition, target.Position - cameraPosition, ray)
                if hit and hit.Instance == target then vantage = candidate; break end
            end
        end
        if vantage then break end
    end
    assert(vantage, "Bird Guide target is obstructed from the available viewing positions.")
    BadgeUnlocker.move(run, vantage)
    run.zoom = funCamera.zoom
    if run.zoom then
        funCamera:setZoom(false)
        setthreadidentity(8)
        zoomToggle:Set(false, true)
    end
    run.freecam = funCamera.freecam
    if run.freecam then
        funCamera:setFreecam(false)
        setthreadidentity(8)
        freecamToggle:Set(false, true)
    end
    local camera = assert(workspace.CurrentCamera, "Camera is unavailable.")
    run.camera = { instance = camera, kind = camera.CameraType, subject = camera.CameraSubject,
        cframe = camera.CFrame, focus = camera.Focus }
    camera.CameraType = Enum.CameraType.Scriptable
    setthreadidentity(8)
    notify("Bird Guide: watching the pigeons for 15 minutes. Press Unlock all badges again to cancel.")
    local started, nextCheck, nextProgress = os.clock(), 0, 60
    while os.clock() - started <= shared.WATCH_DURATION_SECONDS + 30 do
        BadgeUnlocker.check(run)
        assert(target.Parent and (run.root.Position - target.Position).Magnitude <= shared.MAXIMUM_DISTANCE_STUDS,
            "Bird Guide interrupted: character left the pigeon area.")
        camera.CFrame = CFrame.lookAt(run.root.Position + Vector3.new(0, 3, 0), target.Position)
        camera.Focus = CFrame.new(target.Position)
        local elapsed = os.clock() - started
        if elapsed >= nextProgress then
            nextProgress += 60
            BadgeUnlocker.update(string.format("Bird Guide: %02d:%02d / %02d:00 watching pigeons",
                math.floor(elapsed / 60), math.floor(elapsed % 60), math.floor(shared.WATCH_DURATION_SECONDS / 60)))
        end
        if os.clock() >= nextCheck then
            nextCheck = os.clock() + 10
            if game:GetService("Players").LocalPlayer:GetAttribute(shared.AWARDED_ATTRIBUTE) or BadgeUnlocker.owned(entry) then
                BadgeUnlocker.report(run, entry, "Unlocked")
                return
            end
        end
        BadgeUnlocker.wait(run, 0.2)
    end
    BadgeUnlocker.report(run, entry, "Watching attempted; server award not confirmed")
end
function BadgeUnlocker.cleanup(run)
    if run.cleaned then return end
    run.cleaned = true
    if run.camera then
        pcall(function()
            local saved = run.camera
            saved.instance.CameraType = saved.kind
            saved.instance.CameraSubject = saved.subject
            saved.instance.CFrame = saved.cframe
            saved.instance.Focus = saved.focus
        end)
    end
    local player = game:GetService("Players").LocalPlayer
    if run.origin and not run.replacedCharacter and player.Character == run.character and not state.enabled and not AutoFarm.enabled then
        pcall(function() run.character:PivotTo(run.origin) end)
    end
    if run.zoom and state.alive then
        pcall(function() funCamera:setZoom(true); setthreadidentity(8); zoomToggle:Set(true, true) end)
    end
    if run.freecam and state.alive then
        pcall(function() funCamera:setFreecam(true); setthreadidentity(8); freecamToggle:Set(true, true) end)
    end
    if BadgeUnlocker.run == run then BadgeUnlocker.run = nil end
end
function BadgeUnlocker.start()
    setthreadidentity(8)
    if BadgeUnlocker.run then
        BadgeUnlocker.run.cancelled = true
        notify(BadgeUnlocker.run.replacedCharacter and "Cancelling badge attempts and restoring your camera."
            or "Cancelling badge attempts and restoring your position/camera.")
        return
    end
    if not state.alive then return end
    if state.enabled or AutoFarm.enabled then notify("Turn off Autopilot and Auto Farm before attempting badges."); return end
    local run: { [string]: any } = { results = {}, cancelled = false }
    BadgeUnlocker.run = run
    run.thread = task.defer(function()
        setthreadidentity(8)
        local ok, err = pcall(function()
            local missing = {}
            for _, entry in ipairs(BadgeUnlocker.entries) do
                BadgeUnlocker.check(run)
                if BadgeUnlocker.owned(entry) then BadgeUnlocker.report(run, entry, "Already owned")
                else missing[entry.name] = entry end
            end
            if not next(missing) then return end
            -- Settings can be saved without moving the passenger.
            local music = missing["Crab Rave"]
            if music then
                local success, failure = pcall(BadgeUnlocker.music, run, music)
                if not success then BadgeUnlocker.report(run, music, tostring(failure)) end
                missing["Crab Rave"] = nil
            end
            if not next(missing) then return end
            BadgeUnlocker.prepare(run)
            local actions = {
                { "The Weight of the World", function(entry) BadgeUnlocker.touch(run, entry, "yrrebStatue", Vector3.new(724.007, 58.75, 24788.623)) end },
                { "Pier Pressure", function(entry) BadgeUnlocker.touch(run, entry, "NorthshorePier", Vector3.new(44416.664, 19.5, -25125.469)) end },
                { "Visited Every Station", function(entry) BadgeUnlocker.stations(run, entry) end },
                { "Bird Guide", function(entry) BadgeUnlocker.birds(run, entry) end },
            }
            for _, action in ipairs(actions) do
                BadgeUnlocker.check(run)
                local entry = missing[action[1]]
                if entry then
                    BadgeUnlocker.report(run, entry, "Attempting")
                    local success, failure = pcall(action[2], entry)
                    BadgeUnlocker.check(run)
                    if not success then BadgeUnlocker.report(run, entry, tostring(failure)) end
                end
            end
        end)
        BadgeUnlocker.cleanup(run)
        setthreadidentity(8)
        if state.alive then
            if not ok and not run.cancelled then BadgeUnlocker.update("Badge attempts stopped: " .. tostring(err))
            else notify(run.cancelled and "Badge attempts cancelled." or "Badge attempts finished. See Diagnostics for per-badge results.") end
        end
        BadgeUnlocker.lastResults = run.results
    end)
end
BadgeUnlocker.button = misc:CreateButton({ name = "Unlock all badges",
    description = "Attempt five exploration badges as a Passenger. Bird Guide takes 15 minutes. Press again to cancel.",
    callback = BadgeUnlocker.start })

local function initialize()
    modules = game:GetService("ReplicatedStorage"):FindFirstChild("Modules")
    local train = modules and modules:FindFirstChild("Train")
    if not train then error("SCR train modules are unavailable.") end
    driver = require(train:FindFirstChild("TrainDriver"))
    utility = require(train:FindFirstChild("TrainUtility"))
    enums = require(modules:FindFirstChild("CustomEnum"))
    accelerationModel = require(train:FindFirstChild("Acceleration"))
    autoThrottle = require(train:FindFirstChild("AutoThrottle"))
end
local function loadedMover()
    if not driver then initialize() end
    local mover = driver.GetCurrentTrainMover()
    local model = mover and mover.skeletonModel and mover.skeletonModel.Parent
    if not model or mover.isDestroyed then return nil end
    -- IsLoading means passenger loading, not that the vehicle is absent.
    return mover, model
end
local function hud()
    local player = game:GetService("Players").LocalPlayer
    return player and path(player, { "PlayerGui", "DriveGui" })
end
local function button(name)
    return path(hud(), { "Cluster", "AwsIndicatorMinimal", name })
end
local function callbackFor(guiButton)
    if not guiButton then return nil end
    if callbackCache[guiButton] then return callbackCache[guiButton] end
    for _, connection in ipairs(getconnections(guiButton.Activated)) do
        if type(connection.Function) == "function" then
            callbackCache[guiButton] = connection.Function
            return connection.Function
        end
    end
    return nil
end
local function emergencyState()
    if emergencyCache then return emergencyCache.value, emergencyCache.callback end
    local callback = callbackFor(button("BrakeButton"))
    if not callback then error("Emergency release callback unavailable.") end
    for _, value in pairs(getupvalues(callback)) do
        if type(value) == "table" and value.currentState ~= nil and value.releaseInProgress ~= nil then
            emergencyCache = { value = value, callback = callback }
            return value, callback
        end
    end
    error("Emergency controller state unavailable.")
end
local function canReleaseEmergency(emergency, model)
    if emergency.releaseInProgress or emergency.currentState == enums.EmergencyState.None then return false end
    if emergency.currentState ~= enums.EmergencyState.SignalAtDanger then return true end
    -- Check the signal which caused the SPAD, not the next signal in the HUD.
    local name = model:GetAttribute("EmergencySignalName")
    local signals = workspace:FindFirstChild("Signals")
    local signal = type(name) == "string" and name ~= "" and signals and signals:FindFirstChild(name)
    local aspect = signal and signal:GetAttribute("State")
    if aspect ~= enums.SignalState.Proceed and aspect ~= enums.SignalState.Precaution
        and aspect ~= enums.SignalState.Caution then
        return false, "SPAD - waiting for signal to clear"
    end
    local ok, ready = pcall(function()
        local date = require(modules:FindFirstChild("Date"))
        local brakeTime = model:GetAttribute("EmergencyBrakeTime")
        local waitSeconds = utility.EMERGENCY_BRAKE_WAIT_SECONDS
        local additional = emergency.additionalWaitSeconds or 0
        local now = date.GetTime()
        return type(brakeTime) == "number" and type(waitSeconds) == "number"
            and type(additional) == "number" and type(now) == "number"
            and now >= brakeTime + waitSeconds + additional
    end)
    if not ok then return false, "SPAD - release timing unavailable" end
    if not ready then return false, "SPAD - waiting for release countdown" end
    return true, "SPAD - signal clear; waiting for permitted release"
end
-- Intercept the mover call before it zeros speed; polling after SPAD is too late.
-- Keep the override local to our train and restore its previous instance method.
local PlatformRecovery: { [string]: any } = { validated = false, claimOccupancy = true }
local SpadBypass: { [string]: any } = {}
function SpadBypass.needed()
    if config.bypassSpad or SpadBypass.chooseArmed
        or (SpadBypass.junction and SpadBypass.junction.requested) then return true end
    for _, plan in pairs(SpadBypass.junctionPlans or {}) do if plan.requested then return true end end
    return false
end
function SpadBypass.choiceActive(hold)
    return state.alive and (config.bypassSpad or hold.requested)
end
function SpadBypass.resetChoice()
    SpadBypass.chooseArmed = false
    setthreadidentity(8)
    chooseJunctionToggle:Set(false, true)
end
function SpadBypass.isSpad(mover)
    local model = mover and mover.skeletonModel and mover.skeletonModel.Parent
    if not model or mover.isDestroyed then return false end
    local brakeTime = model:GetAttribute("EmergencyBrakeTime")
    return brakeTime ~= nil and brakeTime ~= 0 and model:GetAttribute("EmergencySignalName") ~= nil
end
-- Keep the native section-crossing order so a rejected SPAD entry can be
-- registered later. Platform loading and skipped stops remain server-owned.
function SpadBypass.bindSectionRecovery(mover)
    local original = mover.sensorCallback
    if type(original) ~= "function" then return end
    local journal = {}
    SpadBypass.sectionJournal = journal
    SpadBypass.sensorPrevious = rawget(mover, "sensorCallback")
    SpadBypass.sensorOverride = function(sensor, forward, front)
        local event
        if state.alive and config.bypassSpad and SpadBypass.mover == mover
            and sensor.sensorType == enums.SensorType.SectionMarker then
            event = { section = sensor.extraData.sectionIds[front and (forward and "A" or "B")
                or (forward and "B" or "A")], signal = front and forward and sensor.extraData.signalId or nil,
                enter = front, done = false }
            table.insert(journal, event)
            if #journal > 128 then table.remove(journal, 1) end
            local recovery = SpadBypass.sectionRecovery
            if recovery and not recovery.complete then
                if #recovery.queue < 256 then table.insert(recovery.queue, event)
                else recovery.overflow = true end
            end
        end
        local result = table.pack(pcall(original, sensor, forward, front))
        if event then event.done = true end
        if not result[1] then error(result[2], 0) end
        return table.unpack(result, 2, result.n)
    end
    mover.sensorCallback = SpadBypass.sensorOverride
end
function SpadBypass.updateSectionRecovery()
    local mover, journal = SpadBypass.mover, SpadBypass.sectionJournal
    if not mover or not journal or not SpadBypass.isSpad(mover) then return end
    local platformBinding = PlatformRecovery.binding
    if platformBinding and platformBinding.context and platformBinding.context.busy then return end
    local model = mover.skeletonModel.Parent
    local emergency = emergencyState()
    if emergency.currentState ~= enums.EmergencyState.SignalAtDanger or emergency.releaseInProgress then return end
    local signalName = model:GetAttribute("EmergencySignalName")
    local signals = workspace:FindFirstChild("Signals")
    local signal = signals and signals:FindFirstChild(signalName)
    if not signal then return end
    local time = model:GetAttribute("EmergencyBrakeTime")
    local recovery = SpadBypass.sectionRecovery
    if not recovery or recovery.time ~= time or recovery.signal ~= signalName then
        local start
        for index = #journal, 1, -1 do
            if journal[index].enter and journal[index].signal == signal:GetAttribute("SignalId") then start = index; break end
        end
        if not start then return end -- No observed crossing to replay; do not guess section IDs.
        recovery = { time = time, signal = signalName, queue = {}, entered = {}, nextAttempt = 0 }
        for index = start, #journal do table.insert(recovery.queue, journal[index]) end
        SpadBypass.sectionRecovery = recovery
    end
    if recovery.complete or recovery.overflow or recovery.busy or os.clock() < recovery.nextAttempt then return end
    local aspect = signal:GetAttribute("State")
    if aspect ~= enums.SignalState.Proceed and aspect ~= enums.SignalState.Precaution and aspect ~= enums.SignalState.Caution then return end
    recovery.nextAttempt, recovery.busy = os.clock() + 3, true
    local function active()
        return state.alive and config.bypassSpad and SpadBypass.mover == mover and not mover.isDestroyed
            and SpadBypass.sectionRecovery == recovery and model:GetAttribute("EmergencyBrakeTime") == time
            and model:GetAttribute("EmergencySignalName") == signalName
    end
    task.defer(function()
        local ok, failure = pcall(function()
            local communication = require(modules:FindFirstChild("Communication"))
            -- Bound each batch; RPC waits never block the driving heartbeat.
            for _ = 1, 8 do
                if not active() then return end
                local event = recovery.queue[1]
                if not event then
                    recovery.complete = true
                    log("SPAD section registration recovered; station handling remains controlled by the server.")
                    return
                end
                if not event.done then return end
                if event.enter or recovery.entered[event.section] then
                    local result
                    if event.enter then result = communication.GetFunction("EnterSection"):Invoke(event.section, event.signal)
                    else result = communication.GetFunction("ExitSection"):Invoke(event.section) end
                    if not active() then return end
                    local response = type(result) == "table" and result.sectionResponse or result
                    if response ~= enums.SectionResponse.Accepted and response ~= enums.SectionResponse.NotSignalled then return end
                    if event.enter and type(result) == "table" and result.stationName and result.platformName then
                        local stations = game:GetService("ReplicatedStorage"):FindFirstChild("Stations")
                        local station = stations and stations:FindFirstChild(result.stationName)
                        local platforms = station and station:FindFirstChild("Platforms")
                        local platform = platforms and platforms:FindFirstChild(result.platformName)
                        local occupied = platform and platform:FindFirstChild("OccupiedTrain")
                        if not occupied or occupied.Value ~= model then return end
                    end
                    if event.enter then
                        recovery.entered[event.section] = true
                        if type(result) == "table" then
                            for _, junction in ipairs(result.junctionMap or {}) do
                                mover:SetJunctionSetting(junction.junctionId, junction.nodeGroups)
                            end
                        end
                    else recovery.entered[event.section] = nil end
                end
                -- Only release sections re-entered by this recovery, after a
                -- recorded REAR crossing. Never claim another train's platform locally.
                table.remove(recovery.queue, 1)
            end
        end)
        recovery.busy = false
        if not ok and active() and recovery.lastError ~= tostring(failure) then
            recovery.lastError = tostring(failure)
            log("SPAD section recovery waiting: " .. tostring(failure))
        end
    end)
end
function SpadBypass.clearManualInput()
    SpadBypass.drag = nil
    for _, connection in ipairs(SpadBypass.inputConnections or {}) do connection:Disconnect() end
    SpadBypass.inputConnections = nil
end
function SpadBypass.bindManualInput()
    local input = game:GetService("UserInputService")
    local handle = path(hud(), { "Additional", "SimpleTouch", "Guide", "Handle" })
    local connections = {}
    SpadBypass.inputConnections = connections
    if handle then
        table.insert(connections, handle.InputBegan:Connect(function(event)
            if event.UserInputType == Enum.UserInputType.Touch
                or event.UserInputType == Enum.UserInputType.MouseButton1 then
                -- Keep our own drag: SCR clears its drag while emergencyState is SPAD.
                SpadBypass.drag = { input = event, handle = handle }
            end
        end))
    end
    table.insert(connections, input.InputEnded:Connect(function(event)
        local drag = SpadBypass.drag
        if drag and (event == drag.input or (drag.input.UserInputType == Enum.UserInputType.MouseButton1
            and event.UserInputType == Enum.UserInputType.MouseButton1)) then SpadBypass.drag = nil end
    end))
    table.insert(connections, input.WindowFocusReleased:Connect(function() SpadBypass.drag = nil end))
end
function SpadBypass.updateManualControls(dt)
    local mover = SpadBypass.mover
    -- SCR's heartbeat ignores ALL manual speed input during an emergency, even
    -- when ApplyEmergencyBrake was intercepted. Restore only the manual SPAD
    -- input path; do not change the shared emergency/release state or fight AP.
    if not state.alive or not config.bypassSpad or state.enabled or not SpadBypass.isSpad(mover) then return end
    if mover.isPaused or SpadBypass.junction then return end
    local model = mover.skeletonModel.Parent
    local emergency = emergencyState()
    if model:GetAttribute("IsLoading") or emergency.currentState ~= enums.EmergencyState.SignalAtDanger then return end
    if mover.areControlsLocked or mover.areControlsSoftLocked then return end
    local input = game:GetService("UserInputService")
    if input:GetFocusedTextBox() then return end
    local delta = 0
    for _, key in ipairs(input:GetKeysPressed()) do
        if key.KeyCode == Enum.KeyCode.W or key.KeyCode == Enum.KeyCode.Up then delta += 1 end
        if key.KeyCode == Enum.KeyCode.S or key.KeyCode == Enum.KeyCode.Down then delta -= 1 end
    end
    for _, pad in ipairs(input:GetConnectedGamepads()) do
        for _, key in ipairs(input:GetGamepadState(pad)) do
            if key.KeyCode == Enum.KeyCode.ButtonR2 then delta += key.Position.Z end
            if key.KeyCode == Enum.KeyCode.ButtonL2 then delta -= key.Position.Z end
        end
    end
    if delta ~= 0 then mover:ApplyThrottleDelta(math.clamp(delta, -1, 1) * math.min(dt, 0.1) * 25) end
    local drag = SpadBypass.drag
    if not drag then return end
    local event, handle = drag.input, drag.handle
    if not handle.Parent or event.UserInputState == Enum.UserInputState.End
        or event.UserInputState == Enum.UserInputState.Cancel then SpadBypass.drag = nil; return end
    local guide = handle.Parent
    local gui = guide:FindFirstAncestorWhichIsA("ScreenGui")
    if not gui or not gui.Enabled or not guide.Parent.Visible or guide.AbsoluteSize.Y <= 0 then return end
    local y = event.Position.Y
    if event.UserInputType == Enum.UserInputType.MouseButton1 then
        y = input:GetMouseLocation().Y
        if not gui.IgnoreGuiInset then y -= game:GetService("GuiService"):GetGuiInset().Y end
    end
    local target = (1 - math.clamp((y - guide.AbsolutePosition.Y) / guide.AbsoluteSize.Y, 0, 1)) * mover.maxSpeed
    mover:SetTargetSpeed(target < 5 and 0 or target)
end
function SpadBypass.detach(reapply)
    SpadBypass.clearManualInput()
    local mover, original = SpadBypass.mover, SpadBypass.original
    if not mover then return end
    local hold = SpadBypass.junction
    if hold and hold.requested and hold.previousGroups and not mover.isDestroyed and SpadBypass.junctionOriginal then
        SpadBypass.junctionOriginal(mover, hold.id, hold.previousGroups)
    end
    SpadBypass.closeJunction()
    if SpadBypass.sensorOverride and rawget(mover, "sensorCallback") == SpadBypass.sensorOverride then
        rawset(mover, "sensorCallback", SpadBypass.sensorPrevious)
    end
    SpadBypass.sensorOverride, SpadBypass.sensorPrevious = nil, nil
    SpadBypass.sectionJournal, SpadBypass.sectionRecovery = nil, nil
    SpadBypass.junctionPlans, SpadBypass.choiceSession = nil, nil
    if SpadBypass.junctionOverride and rawget(mover, "SetJunctionSetting") == SpadBypass.junctionOverride then
        rawset(mover, "SetJunctionSetting", SpadBypass.junctionPrevious)
    end
    SpadBypass.junctionOriginal, SpadBypass.junctionOverride, SpadBypass.junctionPrevious = nil, nil, nil
    if rawget(mover, "ApplyEmergencyBrake") == SpadBypass.override then
        rawset(mover, "ApplyEmergencyBrake", SpadBypass.previous)
    end
    SpadBypass.mover, SpadBypass.original, SpadBypass.override, SpadBypass.previous = nil, nil, nil, nil
    if reapply and SpadBypass.isSpad(mover) then original(mover) end
end
function SpadBypass.sync(mover)
    if not SpadBypass.needed() then SpadBypass.detach(true); return end
    if mover == SpadBypass.mover then return end
    SpadBypass.detach(false)
    if not SpadBypass.needed() or not mover then return end
    local original = mover.ApplyEmergencyBrake
    if type(original) ~= "function" then error("SPAD brake controller unavailable.") end
    local override = function(self, ...)
        if state.alive and config.bypassSpad and self == mover and SpadBypass.isSpad(self) then return end
        return original(self, ...)
    end
    SpadBypass.mover, SpadBypass.original = mover, original
    SpadBypass.previous, SpadBypass.override = rawget(mover, "ApplyEmergencyBrake"), override
    mover.ApplyEmergencyBrake = override
    SpadBypass.junctionPlans = {}
    SpadBypass.bindSectionRecovery(mover)
    local setter = mover.SetJunctionSetting
    if type(setter) == "function" then
        SpadBypass.junctionOriginal, SpadBypass.junctionPrevious = setter, rawget(mover, "SetJunctionSetting")
        SpadBypass.junctionOverride = function(self, id, groups)
            if self == mover and state.alive and SpadBypass.needed() then
                local plan = (SpadBypass.junctionPlans or {})[id]
                if not SpadBypass.junction and self.isPaused and self.pauseJunctionId == id
                    and (plan or (config.bypassSpad and SpadBypass.isSpad(self))) then
                    if SpadBypass.beginJunction(self, id) then return end
                end
                local hold = SpadBypass.junction
                if hold and hold.mover == self and hold.id == id then
                    local changed = not hold.serverGroups or #hold.serverGroups ~= #groups
                    if not changed then
                        for index, group in ipairs(groups) do
                            if hold.serverGroups[index] ~= group then changed = true; break end
                        end
                    end
                    hold.serverGroups = table.clone(groups)
                    if hold.recovery and #groups > 0 then
                        task.defer(function()
                            if SpadBypass.junction == hold then
                                pcall(SpadBypass.resumeJunction, hold, { useDefault = true }, "default")
                            end
                        end)
                    elseif changed and hold.shown then
                        hold.routes, hold.page = nil, 1
                        task.defer(SpadBypass.showJunction, hold)
                    end
                    return -- A late server setting must not resume an undecided train.
                end
                plan = (SpadBypass.junctionPlans or {})[id]
                if plan then
                    plan.defaultGroups = table.clone(groups)
                    return setter(self, id, plan.groups)
                end
            end
            return setter(self, id, groups)
        end
        mover.SetJunctionSetting = SpadBypass.junctionOverride
    end
    SpadBypass.bindManualInput()
    -- Enabling during an existing SPAD permits driving again, without inventing a speed.
    if config.bypassSpad and SpadBypass.isSpad(mover) and not mover.skeletonModel.Parent:GetAttribute("IsLoading") then
        mover:UnlockControls()
    end
end
function SpadBypass.closeJunction()
    local hold = SpadBypass.junction
    SpadBypass.junction = nil
    if hold and hold.popup then hold.popup:Close() end
end
function SpadBypass.beginJunction(mover, id, requested)
    local plan = (SpadBypass.junctionPlans or {})[id]
    local previous = mover.junctionSettings and mover.junctionSettings[id]
    local hold = { mover = mover, id = id, page = 1,
        requested = requested or (plan and plan.requested),
        previousGroups = previous and table.clone(previous) }
    SpadBypass.junction = hold
    -- Resolve a sole complete exit before clearing any stored speed/throttle.
    -- Ambiguous or unavailable track data still requires a stopped choice.
    local ok, routes = pcall(SpadBypass.junctionRoutes, mover, id)
    if ok and plan then
        local continuation, compatible, count = nil, nil, 0
        for _, route in ipairs(routes) do
            if plan.exitKey and route.exitKey == plan.exitKey then continuation = route; break end
            local samePath = true
            for _, group in ipairs(route.groups) do
                if not table.find(plan.groups, group) then samePath = false; break end
            end
            if samePath then compatible = route; count += 1 end
        end
        -- The next junction's server setting can change the trace's endpoint.
        -- A unique remaining path inside the committed groups is still our exit.
        continuation = continuation or (count == 1 and compatible or nil)
        if continuation then
            local resumed, result = pcall(SpadBypass.resumeJunction, hold, continuation, "continue")
            if resumed and result then return true end
        end
    end
    if ok and #routes == 1 then
        local resumed, result = pcall(SpadBypass.resumeJunction, hold, routes[1], true)
        if resumed and result then return true end
    end
    SpadBypass.holdJunction()
    return false
end
function SpadBypass.holdJunction()
    local hold = SpadBypass.junction
    if not hold then return end
    local mover = hold.mover
    if mover ~= SpadBypass.mover or mover.isDestroyed then SpadBypass.closeJunction(); return end
    -- Capture once: subsequent hold ticks must not overwrite the original values with zeros.
    if not hold.motion then
        hold.motion = {}
        for _, key in ipairs({ "currentSpeed", "targetSpeed", "throttle", "acceleration" }) do
            local value = mover[key]
            if type(value) == "number" and value == value and math.abs(value) < math.huge then
                hold.motion[key] = value
            end
        end
    end
    -- Keep native/manual/AP movement stopped until the chosen route is accepted.
    mover.currentSpeed, mover.acceleration, mover.targetSpeed, mover.throttle = 0, 0, 0, 0
    mover.isPaused, mover.pauseJunctionId = true, hold.id
    SpadBypass.drag = nil
end
function SpadBypass.nodeSelector(mover)
    local selectNode
    local inspected = {}
    local function findSelector(fn, depth)
        if selectNode or depth > 3 or type(fn) ~= "function" or inspected[fn] then return end
        inspected[fn] = true
        for _, value in pairs(debug.getupvalues(fn)) do
            if type(value) == "function" then
                if debug.info(value, "n") == "selectNextNode" then selectNode = value
                elseif depth < 3 then findSelector(value, depth + 1) end
            end
        end
    end
    findSelector(mover.Initialise, 1)
    return selectNode
end
function SpadBypass.junctionGroups(mover, id)
    if type(mover.Initialise) ~= "function" then return end
    local groups
    for _, value in pairs(debug.getupvalues(mover.Initialise)) do
        if type(value) == "table" and type(value[id]) == "table" then
            for _, nodes in pairs(value[id]) do
                local node = type(nodes) == "table" and nodes[1]
                if type(node) == "table" and node.junctionId == id and typeof(node.position) == "Vector3" then
                    groups = value[id]; break
                end
            end
        end
    end
    return groups
end
function SpadBypass.occupiedGroups(mover, id, groups)
    local result = table.clone(groups)
    for _, carriage in ipairs(mover.carriages or {}) do
        for _, bogie in ipairs(carriage.bogies) do
            for _, node in pairs({ bogie.prevNode, bogie.currentNode }) do
                if node.junctionId == id and node.nodeGroupId and not table.find(result, node.nodeGroupId) then
                    table.insert(result, node.nodeGroupId)
                end
            end
        end
    end
    return result
end
function SpadBypass.rememberJunction(mover, hold, route, groups)
    SpadBypass.junctionPlans = SpadBypass.junctionPlans or {}
    local previous = SpadBypass.junctionPlans[hold.id]
    SpadBypass.junctionPlans[hold.id] = { groups = table.clone(groups), exitKey = route.exitKey,
        requested = hold.requested or (previous and previous.requested), entered = previous and previous.entered,
        defaultGroups = hold.serverGroups or hold.previousGroups or (previous and previous.defaultGroups),
        trackGroups = SpadBypass.junctionGroups(mover, hold.id) }
end
function SpadBypass.pruneJunctionPlans(mover)
    local trainModules: any = game:GetService("ReplicatedStorage"):FindFirstChild("Modules")
    local loadModule: any = require
    local distance = loadModule(trainModules.Train.TrainUtility).MAX_NODE_SEARCH_DISTANCE_STUDS
    for id, plan in pairs(SpadBypass.junctionPlans or {}) do
        if plan.trackGroups then
            local nearby = false
            for _, carriage in ipairs(mover.carriages) do
                for _, bogie in ipairs(carriage.bogies) do
                    if (bogie.currentNode and bogie.currentNode.junctionId == id)
                        or (bogie.prevNode and bogie.prevNode.junctionId == id) then plan.entered = true; nearby = true end
                    for _, nodes in pairs(plan.trackGroups) do
                        for _, node in ipairs(nodes) do
                            if (node.position - bogie.position).Magnitude <= distance then nearby = true; break end
                        end
                        if nearby then break end
                    end
                end
            end
            if plan.entered and not nearby then SpadBypass.junctionPlans[id] = nil end
        end
    end
end
function SpadBypass.traceJunction(mover, id, entry, allowed, selectNode, groups, searchDistance)
    local settings = table.clone(mover.junctionSettings)
    settings[id] = allowed
    local from, current, excluded = entry.from, entry.current, table.clone(entry.excluded)
    local used, complete, exitNode = {}, false, nil
    for _, node in pairs({ entry.current, entry.excluded[2] }) do
        if node.junctionId == id and node.nodeGroupId then used[node.nodeGroupId] = true end
    end
    for _ = 1, 512 do
        local nextNode, junctionId = selectNode(from, current.position, settings, current.junctionId, excluded)
        if not nextNode then
            complete = next(used) ~= nil and junctionId ~= nil and junctionId ~= id
            if complete then exitNode = current end
            break
        end
        if nextNode.junctionId and nextNode.junctionId ~= id then
            complete = next(used) ~= nil; exitNode = nextNode; break
        end
        if not nextNode.junctionId and next(used) then
            local closest = math.huge
            for _, nodes in pairs(groups) do
                for _, node in ipairs(nodes) do closest = math.min(closest, (node.position - nextNode.position).Magnitude) end
            end
            -- Untagged nodes can connect two groups of the SAME junction.
            -- Do not declare a route complete at the first untagged node.
            if closest > searchDistance then complete = true; exitNode = nextNode; break end
        end
        if table.find(excluded, nextNode) then break end
        if nextNode.junctionId == id then used[nextNode.nodeGroupId] = true end
        table.insert(excluded, nextNode)
        from, current = current.position, nextNode
    end
    return complete and exitNode or nil
end
function SpadBypass.junctionRoutes(mover, id, entryOverride)
    local selectNode, groups = SpadBypass.nodeSelector(mover), SpadBypass.junctionGroups(mover, id)
    local trainModules: any = game:GetService("ReplicatedStorage"):FindFirstChild("Modules")
    local loadModule: any = require
    local searchDistance = loadModule(trainModules.Train.TrainUtility).MAX_NODE_SEARCH_DISTANCE_STUDS
    if not selectNode or not groups then return {}, "Track data unavailable" end
    local ids = {}
    for group in pairs(groups) do table.insert(ids, group) end
    table.sort(ids)
    if #ids > 8 then return {}, "Too many branches to verify" end
    local entry = entryOverride
    local backwards = mover.isInitialDirection == false
    for offset = 0, #mover.carriages - 1 do
        if entry then break end
        local carriage = mover.carriages[backwards and (#mover.carriages - offset) or (offset + 1)]
        for index = 1, #carriage.bogies do
            local bogie = carriage.bogies[backwards and (#carriage.bogies - index + 1) or index]
            local current = bogie.currentNode
            if current then
                local previous = bogie.prevNode
                local from = previous and previous.position or bogie.position - carriage.trackingPart.CFrame.LookVector
                    * (mover.isInitialDirection and 10 or -10)
                local excluded = { current }
                if previous then table.insert(excluded, previous) end
                local nextNode, junctionId = selectNode(from, current.position, mover.junctionSettings, current.junctionId, excluded)
                if not nextNode and junctionId == id then
                    entry = { from = from, current = current, excluded = excluded }; break
                end
            end
        end
        if entry then break end
    end
    if not entry then return {}, "Junction approach changed" end
    local result, exits = {}, {}
    for mask = 1, 2 ^ #ids - 1 do
        local allowed = {}
        for i, group in ipairs(ids) do if bit32.band(mask, 2 ^ (i - 1)) ~= 0 then table.insert(allowed, group) end end
        local exitNode = SpadBypass.traceJunction(mover, id, entry, allowed, selectNode, groups, searchDistance)
        if exitNode then
            -- Keep the exact setting tested by the native selector. Groups on
            -- the approach can also enable an unwanted outgoing branch.
            local actual, labels = table.clone(allowed), {}
            for _, group in ipairs(actual) do table.insert(labels, tostring(group)) end
            local key = table.concat(labels, ",")
            -- All track combinations reaching the same outgoing node are one
            -- exit choice. The internal group list is retained only for driving.
            local position = exitNode.position
            local exitKey = string.format("%.2f/%.2f/%.2f", position.X, position.Y, position.Z)
            local known = exits[exitKey]
            if not known then
                local forward = entry.current.position - entry.from
                local outgoing = position - entry.current.position
                local flatForward = Vector3.new(forward.X, 0, forward.Z)
                local flatOutgoing = Vector3.new(outgoing.X, 0, outgoing.Z)
                local turn, side
                if flatForward.Magnitude > 0.01 and flatOutgoing.Magnitude > 0.01 then
                    turn = math.atan2(flatForward.Unit:Cross(flatOutgoing.Unit).Y, flatForward.Unit:Dot(flatOutgoing.Unit))
                    side = flatForward.Unit:Cross(flatOutgoing).Y
                end
                known = { groups = actual, key = key, exitKey = exitKey, position = position, turn = turn, side = side, entry = entry }
                exits[exitKey] = known
                table.insert(result, known)
            elseif #actual < #known.groups then
                known.groups, known.key = actual, key
            end
        end
    end
    table.sort(result, function(a, b)
        if (a.turn or 0) ~= (b.turn or 0) then return (a.turn or 0) > (b.turn or 0) end
        return a.exitKey < b.exitKey
    end)
    for index, exit in ipairs(result) do
        local direction = exit.side and (exit.side > 4 and "Left" or exit.side < -4 and "Right" or "Ahead")
        exit.name = "Exit " .. index .. (direction and (" · " .. direction) or "")
    end
    return result, #result == 0 and "No complete route verified" or nil
end
function SpadBypass.resumeJunction(hold, route, automatic)
    if SpadBypass.junction ~= hold or not SpadBypass.choiceActive(hold)
        or SpadBypass.mover ~= hold.mover or hold.mover.isDestroyed then return false end
    local mover, emergency = hold.mover, emergencyState()
    if hold.position and (mover:GetFrontBogie().position - hold.position).Magnitude > 5 then
        hold.message = "Train position changed. Staying stopped."; return false
    end
    if mover.skeletonModel.Parent:GetAttribute("IsLoading") or emergency.releaseInProgress
        or (emergency.currentState ~= enums.EmergencyState.None and emergency.currentState ~= enums.EmergencyState.SignalAtDanger)
        or mover.areControlsLocked or mover.areControlsSoftLocked then
        hold.message = "Train controls unavailable. Stay stopped and try again."; return false
    end
    local routes = route.useDefault and {} or SpadBypass.junctionRoutes(mover, hold.id, hold.entry)
    if automatic == true and #routes ~= 1 then
        hold.routes = nil; hold.message = "Route changed. Choose again."; return false
    end
    local verified
    if route.useDefault then
        local groups = hold.serverGroups or hold.previousGroups
        if type(groups) ~= "table" or #groups == 0 then
            hold.message = "Default route unavailable. Choose an exit or retry."; return false
        end
        verified = { groups = table.clone(groups), useDefault = true }
    end
    for _, candidate in ipairs(routes) do
        if candidate.exitKey == route.exitKey and route.exitKey ~= nil then verified = candidate; break end
    end
    if not verified then hold.routes = nil; hold.message = "Route changed. Choose again."; return false end
    if not automatic then SpadBypass.holdJunction() end
    -- Only the saved native setter may release this pause, after revalidation.
    local groups = table.clone(verified.groups)
    if not verified.useDefault then
        -- A one-shot choice is made before entering the junction. Do not add
        -- prefetched default-branch nodes: they can select the old exit again.
        local expanded = hold.requested and table.clone(groups) or SpadBypass.occupiedGroups(mover, hold.id, groups)
        local plan = (SpadBypass.junctionPlans or {})[hold.id]
        if plan then
            local samePath = true
            for _, group in ipairs(groups) do if not table.find(plan.groups, group) then samePath = false; break end end
            if samePath then
                for _, group in ipairs(plan.groups) do if not table.find(expanded, group) then table.insert(expanded, group) end end
            end
        end
        if #expanded > #groups and verified.entry then
            local trackGroups = SpadBypass.junctionGroups(mover, hold.id)
            local selectNode = SpadBypass.nodeSelector(mover)
            local trainModules: any = game:GetService("ReplicatedStorage"):FindFirstChild("Modules")
            local loadModule: any = require
            local distance = loadModule(trainModules.Train.TrainUtility).MAX_NODE_SEARCH_DISTANCE_STUDS
            local exit = trackGroups and selectNode and SpadBypass.traceJunction(mover, hold.id, verified.entry,
                expanded, selectNode, trackGroups, distance)
            if exit and string.format("%.2f/%.2f/%.2f", exit.position.X, exit.position.Y, exit.position.Z) == verified.exitKey then
                groups = expanded
            end
        end
    end
    SpadBypass.junctionOriginal(mover, hold.id, groups)
    if mover.isPaused then hold.message = "The game has not released this junction. Staying stopped."; return false end
    if SpadBypass.junction ~= hold or not SpadBypass.choiceActive(hold)
        or SpadBypass.mover ~= mover or mover.isDestroyed then return false end
    if hold.motion then
        for key, value in pairs(hold.motion) do mover[key] = value end
    end
    SpadBypass.rememberJunction(mover, hold, verified, groups)
    PlatformRecovery.noteChoice(mover, hold, verified, automatic)
    SpadBypass.closeJunction()
    state.lastDesired, state.sample, state.approach, state.fullBrakeSince = nil, nil, nil, nil
    return true
end
function SpadBypass.defaultJunctionExit(hold)
    if not hold.requested then return end
    local groups = hold.serverGroups or hold.previousGroups
    local entry = hold.entry or (hold.routes[1] and hold.routes[1].entry)
    if type(groups) ~= "table" or #groups == 0 or not entry then return end
    local selectNode, trackGroups = SpadBypass.nodeSelector(hold.mover), SpadBypass.junctionGroups(hold.mover, hold.id)
    if not selectNode or not trackGroups then return end
    local trainModules: any = game:GetService("ReplicatedStorage"):FindFirstChild("Modules")
    local loadModule: any = require
    local distance = loadModule(trainModules.Train.TrainUtility).MAX_NODE_SEARCH_DISTANCE_STUDS
    local exit = SpadBypass.traceJunction(hold.mover, hold.id, entry, groups, selectNode, trackGroups, distance)
    if not exit then return end
    local key = string.format("%.2f/%.2f/%.2f", exit.position.X, exit.position.Y, exit.position.Z)
    for _, route in ipairs(hold.routes) do if route.exitKey == key then return route end end
    return
end
function SpadBypass.showJunction(hold)
    if SpadBypass.junction ~= hold or not SpadBypass.choiceActive(hold) then return end
    setthreadidentity(8)
    if hold.popup and not hold.popup._closed then hold.popup:Close() end
    local options, content = {}, "Stopped. Choose an exit to resume with your previous speed and throttle."
    if not hold.routes then
        hold.page = 1
        local ok, routes, message = pcall(SpadBypass.junctionRoutes, hold.mover, hold.id, hold.entry)
        hold.routes = ok and routes or {}
        if ok then hold.message = message else hold.message = "Track data unavailable" end
    end
    local routes = table.clone(hold.routes)
    local ok, default = pcall(SpadBypass.defaultJunctionExit, hold)
    if not ok then default = nil end
    if hold.requested and not hold.serverGroups and not hold.previousGroups then
        content ..= "\nDefault route has not been received from the server yet."
    end
    local function addExit(route, isDefault)
        local label = route.name .. (isDefault and " (default)" or "")
        content ..= "\n" .. label
        table.insert(options, { text = label, callback = function()
            task.defer(function()
                local selection = isDefault and { useDefault = true } or route
                local ok, resumed = pcall(SpadBypass.resumeJunction, hold, selection)
                if not ok then hold.message = "Unable to verify route. Staying stopped." end
                if not ok or not resumed then SpadBypass.showJunction(hold) end
            end)
        end })
    end
    if default then
        for index, route in ipairs(routes) do
            if route == default then table.remove(routes, index); break end
        end
        addExit(default, true)
    end
    local pageSize = default and 1 or 2
    local pages = math.max(1, math.ceil(#routes / pageSize))
    hold.page = math.clamp(hold.page or 1, 1, pages)
    local first = (hold.page - 1) * pageSize + 1
    for index = first, math.min(first + pageSize - 1, #routes) do addExit(routes[index], false) end
    if #routes > pageSize then
        table.insert(options, { text = "More exits", callback = function()
            hold.page = hold.page % pages + 1
            task.defer(SpadBypass.showJunction, hold)
        end })
    elseif #hold.routes == 0 then
        table.insert(options, { text = "Retry", callback = function() hold.routes = nil; task.defer(SpadBypass.showJunction, hold) end })
    end
    if hold.message then content ..= "\n" .. hold.message end
    -- Dismissing leaves the train stopped; the Autopilot tab can reopen this popup.
    hold.popup = window:Popup({ title = "Junction " .. tostring(hold.id), content = content, dismissable = true, options = options })
end
function SpadBypass.recoverUnconfiguredJunction(mover)
    local id = mover.pauseJunctionId
    if not state.alive or not mover.isPaused or not id or SpadBypass.junction then return false end
    local setting = mover.junctionSettings[id]
    if setting and #setting > 0 then return false end
    local followingChoice = false
    for _, plan in pairs(SpadBypass.junctionPlans or {}) do
        if plan.requested and plan.entered then followingChoice = true; break end
    end
    if not followingChoice then return false end
    -- A diversion can reach an adjacent merge absent from the server's original
    -- route map. Use its sole exit, or ask only while no native default exists.
    local ok, routes = pcall(SpadBypass.junctionRoutes, mover, id)
    if not ok or #routes == 0 then return false end
    local hold = { mover = mover, id = id, requested = true, recovery = true, page = 1 }
    SpadBypass.junction = hold
    if #routes > 1 then
        hold.routes, hold.shown = routes, true
        SpadBypass.holdJunction()
        task.defer(SpadBypass.showJunction, hold)
        return true
    end
    local resumed, result = pcall(SpadBypass.resumeJunction, hold, routes[1], true)
    if SpadBypass.junction == hold then SpadBypass.closeJunction() end
    return resumed and result == true
end
function SpadBypass.updateJunction()
    local mover = SpadBypass.mover
    if not mover then return end
    SpadBypass.pruneJunctionPlans(mover)
    local hold = SpadBypass.junction
    if hold and hold.mover ~= mover then SpadBypass.closeJunction(); hold = nil end
    if not hold and SpadBypass.recoverUnconfiguredJunction(mover) then return end
    if not hold and mover.isPaused and mover.pauseJunctionId and
        ((config.bypassSpad and SpadBypass.isSpad(mover))
            or (SpadBypass.junctionPlans or {})[mover.pauseJunctionId]) then
        SpadBypass.beginJunction(mover, mover.pauseJunctionId)
        hold = SpadBypass.junction
    end
    if hold and not hold.shown then
        hold.shown = true
        task.defer(SpadBypass.showJunction, hold)
    end
end
-- A one-shot choice watches the front bogie before it enters a junction,
-- including junctions already configured by a green-signal server response.
function SpadBypass.nextChoiceApproach(mover)
    local selectNode = SpadBypass.nodeSelector(mover)
    if not selectNode then return end
    local bogie, direction = mover:GetFrontBogie()
    if not bogie or not bogie.currentNode then return end
    local current, previous = bogie.currentNode, bogie.prevNode
    local from = previous and previous.position or bogie.position - direction * 10
    local excluded = { current }
    if previous then table.insert(excluded, previous) end
    local origin, distance = current.junctionId, (current.position - bogie.position).Magnitude
    -- currentNode is a target ahead of the bogie. Its junction tag does not
    -- mean the train has already entered that junction.
    if origin and previous and previous.junctionId ~= origin and not (SpadBypass.chooseIgnored or {})[origin] then
        return origin, { from = previous.position - direction * 10,
            current = previous, excluded = { previous } }, distance
    end
    for _ = 1, 128 do
        local nextNode, unresolved = selectNode(from, current.position, mover.junctionSettings, current.junctionId, excluded)
        local id = nextNode and nextNode.junctionId or unresolved
        if id and id ~= origin and not (SpadBypass.chooseIgnored or {})[id] then
            if distance <= 80 then return id, { from = from, current = current, excluded = table.clone(excluded) }, distance end
            return
        end
        if not nextNode or table.find(excluded, nextNode) then return end
        distance += (nextNode.position - current.position).Magnitude
        if distance > 80 then return end
        table.insert(excluded, nextNode)
        from, current = current.position, nextNode
    end
    return
end
function SpadBypass.updateChoice(dt)
    if not SpadBypass.chooseArmed or SpadBypass.junction then return end
    SpadBypass.chooseElapsed = (SpadBypass.chooseElapsed or 0) + dt
    if SpadBypass.chooseElapsed < 0.1 then return end
    SpadBypass.chooseElapsed = 0
    local mover = SpadBypass.mover
    if not mover or mover.isDestroyed or mover.skeletonModel.Parent:GetAttribute("IsLoading") then return end
    if mover.isPaused and mover.pauseJunctionId then
        SpadBypass.beginJunction(mover, mover.pauseJunctionId, true)
        SpadBypass.resetChoice()
        return
    end
    local id, entry, distance = SpadBypass.nextChoiceApproach(mover)
    if not id then return end
    -- Do not stop well before the section marker that supplies the default.
    if not mover.junctionSettings[id] and distance and distance > 20 then return end
    local routes = SpadBypass.junctionRoutes(mover, id, entry)
    if #routes <= 1 then
        if #routes == 1 then SpadBypass.chooseIgnored[id] = true end
        return
    end
    local bogie = mover:GetFrontBogie()
    local previous = mover.junctionSettings[id]
    local hold = { mover = mover, id = id, page = 1, requested = true, entry = entry,
        position = bogie.position, routes = routes, shown = true,
        previousGroups = previous and table.clone(previous) }
    SpadBypass.junction = hold
    SpadBypass.holdJunction()
    SpadBypass.resetChoice()
    task.defer(SpadBypass.showJunction, hold)
end
-- Passive observation is always enabled. RPC recovery stays gated until live validation.
function PlatformRecovery.report(context, key, message)
    context.notices = context.notices or {}
    if context.notices[key] then return end
    context.notices[key] = true
    log(message)
    notify(message)
end
function PlatformRecovery.identity(mover)
    local model = mover.skeletonModel.Parent
    return table.concat({ tostring(model:GetAttribute("RouteCode")), tostring(model:GetAttribute("LegSequence")),
        tostring(model:GetAttribute("LegDirection")), tostring(mover.isInitialDirection), tostring(model:GetAttribute("NextStop")) }, "/")
end
function PlatformRecovery.cancel(binding, reason)
    local context = binding and binding.context
    if context and not context.finished then
        context.finished = true
        if context.started then PlatformRecovery.report(context, "stopped", "Platform recovery stopped: " .. reason) end
    end
end
function PlatformRecovery.detach()
    local binding = PlatformRecovery.binding
    if not binding then return end
    PlatformRecovery.cancel(binding, "train changed or script unloaded")
    PlatformRecovery.binding = nil
    PlatformRecovery.unbindReplies(binding)
    if rawget(binding.mover, "sensorCallback") == binding.wrapper then
        rawset(binding.mover, "sensorCallback", binding.previous)
    end
end
-- Observe replies only inside this train's native sensor callback. RPCs made
-- by recovery (or other scripts/coroutines) must not become native evidence.
function PlatformRecovery.bindReplies(binding)
    local loadModule: any = require
    local communication = loadModule(modules:FindFirstChild("Communication"))
    binding.calls, binding.replies = {}, {}
    for _, name in ipairs({ "EnterSection", "ExitSection" }) do
        local remote = communication.GetFunction(name)
        local original, previous = remote.Invoke, rawget(remote, "Invoke")
        local wrapper
        wrapper = function(self, ...)
            local call = binding.calls[coroutine.running()]
            local event = call and call.event
            local section = select(1, ...)
            local observed, matched = pcall(function()
                return self == remote and PlatformRecovery.binding == binding and state.alive
                    and event and event.enter == (name == "EnterSection") and section == event.section
                    and event.identity == PlatformRecovery.identity(binding.mover)
            end)
            local result = table.pack(pcall(original, self, ...))
            if observed and matched and PlatformRecovery.binding == binding and event.identity == binding.identity then
                local reply = { ok = result[1], completedAt = os.clock(), values = table.pack(table.unpack(result, 2, result.n)) }
                reply.response = result[1] and (type(result[2]) == "table" and result[2].sectionResponse or result[2]) or nil
                event.native = reply
            end
            if not result[1] then error(result[2], 0) end
            return table.unpack(result, 2, result.n)
        end
        binding.replies[name] = { remote = remote, wrapper = wrapper, previous = previous }
        rawset(remote, "Invoke", wrapper)
    end
end
function PlatformRecovery.unbindReplies(binding)
    for _, hook in pairs(binding.replies or {}) do
        if rawget(hook.remote, "Invoke") == hook.wrapper then rawset(hook.remote, "Invoke", hook.previous) end
    end
    binding.replies = nil
end
function PlatformRecovery.sensors(mover)
    local result, seen = {}, {}
    local function visit(value, depth)
        if type(value) ~= "table" or seen[value] or depth > 4 then return end
        seen[value] = true
        if value.sensorType then
            if value.sensorType == enums.SensorType.SectionMarker then table.insert(result, value) end
            return
        end
        for _, child in pairs(value) do if type(child) == "table" then visit(child, depth + 1) end end
    end
    for _, value in pairs(debug.getupvalues(mover.Initialise)) do visit(value, 0) end
    return result
end
function PlatformRecovery.platformSection(binding, platform)
    local position, reference = platform:FindFirstChild("Position"), platform:FindFirstChild("PlatformSignal")
    local signals = workspace:FindFirstChild("Signals")
    local signal = reference and (typeof(reference.Value) == "Instance" and reference.Value
        or signals and signals:FindFirstChild(tostring(reference.Value)))
    local stop = signal and signal:GetAttribute("MarkerPosition")
    if not position or not stop then return nil end
    local signalMarker
    for _, marker in ipairs(binding.sensors) do
        if marker.extraData.signalId == signal:GetAttribute("SignalId") then
            if signalMarker then return nil end
            signalMarker = marker
        end
    end
    if signalMarker then
        local short = signalMarker.extraData.sectionIds.B
        local platformSection
        for _, boundary in ipairs(binding.sensors) do
            local ids = boundary.extraData.sectionIds
            local offset = boundary.position - signalMarker.position
            if boundary ~= signalMarker and (ids.A == short or ids.B == short)
                and offset.Magnitude > 1 and offset.Magnitude <= 100
                and signalMarker.lookVector and offset:Dot(signalMarker.lookVector) < 0 then
                local section = ids.A == short and ids.B or ids.A
                if platformSection and platformSection ~= section then return nil end
                platformSection = section
            end
        end
        return platformSection
    end
    local candidates, found = {}, nil
    for _, marker in ipairs(binding.sensors) do
        if (marker.position - position.Value).Magnitude < 1 then
            for _, section in pairs(marker.extraData.sectionIds) do candidates[section] = true end
        end
    end
    for section in pairs(candidates) do
        local far, ambiguous
        for _, marker in ipairs(binding.sensors) do
            local ids = marker.extraData.sectionIds
            if (ids.A == section or ids.B == section) and (marker.position - position.Value).Magnitude > 20 then
                if far and (far - marker.position).Magnitude > 1 then ambiguous = true end
                far = marker.position
            end
        end
        -- A platform's far boundary ends just before its own exit signal.
        -- The shared entry marker's approach section points away from that signal.
        if far and not ambiguous and (far - stop).Magnitude <= 100 then
            if found then return nil end
            found = section
        end
    end
    return found
end
function PlatformRecovery.platformAt(binding, sensor, section, announcement)
    local announced = announcement or binding.announced
    if not announced then return nil end
    local stations = game:GetService("ReplicatedStorage"):FindFirstChild("Stations")
    local station = stations and stations:FindFirstChild(announced.station)
    local platforms = station and station:FindFirstChild("Platforms")
    local platform = platforms and platforms:FindFirstChild("P" .. announced.platform)
    if platform and PlatformRecovery.platformSection(binding, platform) == section then return platform, announced.station end
    return nil
end
function PlatformRecovery.refreshSensors(binding)
    if #binding.sensors > 0 and not binding.announced then return end
    if os.clock() < (binding.nextSensorRefresh or 0) then return end
    binding.nextSensorRefresh = os.clock() + 3
    local sensors = PlatformRecovery.sensors(binding.mover)
    if #sensors == 0 then return end
    binding.sensors = sensors
    for i = #binding.journal, 1, -1 do
        local event = binding.journal[i]
        local announcement = event.announcement
        -- Older live recorders retained the current unconsumed announcement.
        -- Only use it for the latest entered section, never historical guesses.
        if not announcement and event.enter and event.section == binding.section then announcement = binding.announced end
        if event.enter and not event.platform and announcement then
            event.platform, event.station = PlatformRecovery.platformAt(binding, { position = event.position }, event.section, announcement)
            if event.platform and event.section == binding.section then binding.announced = nil end
        end
    end
end
function PlatformRecovery.record(binding, sensor, forward, front)
    if binding ~= PlatformRecovery.binding or not state.alive then return end
    local identity = PlatformRecovery.identity(binding.mover)
    if identity ~= binding.identity then
        PlatformRecovery.cancel(binding, "route, leg, direction or next stop changed")
        binding.identity, binding.journal, binding.context, binding.announced = identity, {}, nil, nil
    end
    if sensor.sensorType == enums.SensorType.AnnounceSensor and forward and front then
        binding.announced = { station = sensor.extraData.stationName, platform = tostring(sensor.extraData.platformNumber),
            id = sensor.id }
    end
    if sensor.sensorType ~= enums.SensorType.SectionMarker then return end
    local ids = sensor.extraData.sectionIds
    local event = { section = ids[front and (forward and "A" or "B") or (forward and "B" or "A")],
        signal = front and forward and sensor.extraData.signalId or nil, enter = front, forward = forward,
        position = sensor.position, identity = identity, observed = binding.replies ~= nil, done = false,
        assigned = tostring(binding.model:GetAttribute("PlatformNumber")) }
    if front then
        binding.section = event.section
        event.announcement = binding.announced and table.clone(binding.announced)
        event.platform, event.station = PlatformRecovery.platformAt(binding, sensor, event.section)
        if event.platform then binding.announced = nil end
    end
