end
function PlatformRecovery.target(binding, context)
    for i = #context.events, 1, -1 do
        local event = context.events[i]
        if event.enter and event.platform and event.station == context.station
            and event.station == binding.model:GetAttribute("NextStop") and PlatformRecovery.inside(binding, event) then
            local rearCleared = false
            for j = i + 1, #context.events do
                local later = context.events[j]
                if not later.enter and later.section == event.section then rearCleared = true; break end
            end
            if not rearCleared then return event end
        end
    end
    return nil
end
function PlatformRecovery.available(binding, event)
    for _, name in ipairs({ "AllocatedTrain", "OccupiedTrain", "PassingTrain" }) do
        local value = event.platform:FindFirstChild(name)
        if not value or (value.Value and value.Value ~= binding.model) then return false end
    end
    return true
end
function PlatformRecovery.confirmed(binding, context, event)
    local model = binding.model
    local number = event.platform.Name:sub(2)
    local occupied = event.platform:FindFirstChild("OccupiedTrain")
    if tostring(model:GetAttribute("PlatformNumber")) ~= number or not occupied or occupied.Value ~= model then return false end
    -- Native door-unlock eligibility uses assignment + occupancy and a stopped
    -- train. DoorSide/OnPlatform may only update after StartLoading; requiring
    -- them here would incorrectly retry an already successful registration.
    local mover = binding.mover
    return (mover.currentSpeed or 0) <= 0 and (mover.throttle or 0) <= 0
        and (mover.acceleration or 0) <= 0
end
function PlatformRecovery.stop(context, reason)
    context.finished = true
    PlatformRecovery.report(context, "stopped", "Platform recovery stopped: " .. reason)
end
function PlatformRecovery.active(binding, context)
    return state.alive and PlatformRecovery.binding == binding and binding.context == context and not context.finished
        and not binding.mover.isDestroyed and PlatformRecovery.identity(binding.mover) == context.identity
end
function PlatformRecovery.permitted(signalId)
    local signals = workspace:FindFirstChild("Signals")
    for _, signal in ipairs(signals and signals:GetChildren() or {}) do
        if signal:GetAttribute("SignalId") == signalId then
            local aspect = signal:GetAttribute("State")
            return aspect == enums.SignalState.Proceed or aspect == enums.SignalState.Precaution or aspect == enums.SignalState.Caution
        end
    end
    return false
end
function PlatformRecovery.waitForPlatform(binding, context, target)
    if not PlatformRecovery.available(binding, target) then
        context.blockedAt = context.blockedAt or os.clock()
        PlatformRecovery.report(context, "occupied", "Platform recovery waiting: " .. target.platform.Name .. " is reserved or occupied by another train.")
        return true
    end
    if context.blockedAt then
        local waited = os.clock() - context.blockedAt
        context.nextAttempt = context.nextAttempt + waited
        if context.waitUntil then context.waitUntil += waited end
        context.blockedAt = nil
        PlatformRecovery.report(context, "clear", "Platform " .. target.platform.Name .. " is clear; recovery can resume when the signal permits.")
    end
    return false
end
function PlatformRecovery.acknowledged(event)
    local reply = event.native
    return reply and reply.ok and (reply.response == enums.SectionResponse.Accepted or reply.response == enums.SectionResponse.NotSignalled)
end
function PlatformRecovery.buildReplay(context, target)
    local queue, entered, paired, pending, queuedEntries = {}, {}, {}, {}, {}
    local cutoff
    for i, event in ipairs(context.events) do
        if event == target then cutoff = i; break end
    end
    if not cutoff then return nil, "arrival history is incomplete" end
    for i = 1, #context.events do
        local event = context.events[i]
        if i > cutoff and event.enter then continue end
        if not event.done then return nil, "native request pending", true end
        if not event.observed then return nil, "native replies were not recorded; a fresh approach is required" end
        if event.enter then pending[event.section] = event
        else
            local entry = pending[event.section]
            if entry and PlatformRecovery.acknowledged(entry) and PlatformRecovery.acknowledged(event) then
                paired[entry], paired[event] = true, true
            end
            pending[event.section] = nil
        end
    end
    local anchor = context.events[1]
    if not anchor.native or not anchor.native.ok then return nil, "no server reply for the signalled checkpoint; a fresh approach is required" end
    if anchor.native.response ~= enums.SectionResponse.Accepted and anchor.native.response ~= enums.SectionResponse.Rejected then
        return nil, "no accepted or explicitly rejected signalled checkpoint was recorded"
    end
    context.checkpointAccepted = anchor.native.response == enums.SectionResponse.Accepted
    for i = 1, cutoff do
        local event = context.events[i]
        local reply = event.native
        if reply and reply.ok and reply.response == enums.SectionResponse.Unknown then return nil, "server reported an unknown section" end
        if event.enter then
            local accepted = reply and reply.ok and reply.response == enums.SectionResponse.Accepted
            if accepted then entered[event.section] = true
            elseif not paired[event] then
                table.insert(queue, event)
                queuedEntries[event.section] = true
            end
        else
            if queuedEntries[event.section] then
                table.insert(queue, event)
                queuedEntries[event.section] = nil
            elseif paired[event] then entered[event.section] = nil
            elseif not PlatformRecovery.acknowledged(event) then table.insert(queue, event)
            else entered[event.section] = nil end
        end
    end
    -- An approach rear crossing can occur after the front reaches the platform.
    -- Include that recorded exit for a corrected entry, without replaying any
    -- subsequent front/departure entries or inventing a rear crossing.
    for i = cutoff + 1, #context.events do
        local event = context.events[i]
        if not event.enter and queuedEntries[event.section] then
            table.insert(queue, event)
            queuedEntries[event.section] = nil
        end
    end
    return queue, nil, false, entered
end
-- Only repair occupancy after the server has committed the diverted assignment.
-- Never enable the broader experimental section replay for this operation.
function PlatformRecovery.claimArrival(binding, context, target)
    local model, mover = binding.model, binding.mover
    local number = target.platform.Name:sub(2)
    if tostring(context.assigned) == number then return end
    if tostring(model:GetAttribute("PlatformNumber")) ~= number then
        PlatformRecovery.report(context, "assignment", "Diverted platform detected; waiting for the server to assign " .. target.platform.Name .. ".")
        return
    end
    if context.claimDeadline then
        if os.clock() >= context.claimDeadline then
            PlatformRecovery.stop(context, "occupancy was not confirmed; arrival will not be registered twice")
        end
        return
    end
    local function ready()
        if not PlatformRecovery.active(binding, context) or binding.fault or SpadBypass.isSpad(mover)
            or (SpadBypass.sectionRecovery and SpadBypass.sectionRecovery.busy) then return false end
        if PlatformRecovery.target(binding, context) ~= target or not PlatformRecovery.available(binding, target) then return false end
        local allocated, occupied = target.platform:FindFirstChild("AllocatedTrain"), target.platform:FindFirstChild("OccupiedTrain")
        if not allocated or allocated.Value ~= model or not occupied or occupied.Value then return false end
        if tostring(model:GetAttribute("PlatformNumber")) ~= number or model:GetAttribute("CurrentStation") ~= target.station
            or model:GetAttribute("EmergencySignalName") ~= nil or (model:GetAttribute("EmergencyBrakeTime") or 0) ~= 0 then return false end
        if math.abs(mover.currentSpeed or 0) > 0.05 or (mover.throttle or 0) > 0 or (mover.acceleration or 0) > 0 then return false end
        for _, platform in ipairs(target.platform.Parent:GetChildren()) do
            local other = platform:FindFirstChild("OccupiedTrain")
            if platform ~= target.platform and other and other.Value == model then return false end
        end
        return true
    end
    if not ready() then return end
    if not target.done or not target.native or not target.native.ok then return end
    if os.clock() - target.native.completedAt < 2 then return end
    -- An entry already sent under this assignment (or Accepted under any
    -- assignment) must not be duplicated, even while replication is delayed.
    if target.assigned == number or target.native.response == enums.SectionResponse.Accepted then
        PlatformRecovery.stop(context, "native arrival already sent for this platform; refusing duplicate registration")
        return
    end
    if target.native.response ~= enums.SectionResponse.NotSignalled or target.signal ~= nil then
        PlatformRecovery.stop(context, "arrival is not an observed unsignalled platform entry")
        return
    end
    local announcement = target.announcement
    if not announcement or announcement.id == nil or announcement.station ~= target.station or announcement.platform ~= number then
        PlatformRecovery.stop(context, "recorded platform approaching event is missing; make a fresh approach")
        return
    end
    binding.claims = binding.claims or {}
    local key = context.identity .. "/" .. tostring(target.section)
    if binding.claims[key] then
        PlatformRecovery.stop(context, "this diverted arrival has already been attempted; refusing duplicate registration")
        return
    end
    -- Latch before yielding, including failures and cancellation. No automatic retries.
    binding.claims[key], context.busy, context.started = true, true, true
    context.claimDeadline = os.clock() + 8
    PlatformRecovery.report(context, "started", "Registering diverted platform occupancy: " .. target.station .. " " .. target.platform.Name .. ".")
    task.defer(function()
        local ok, failure = pcall(function()
            if not ready() then return end
            local loadModule: any = require
            local communication = loadModule(modules:FindFirstChild("Communication"))
            communication.GetEvent("TriggerApproaching"):Fire(announcement.id)
            task.wait(0.25)
            if not ready() then return end
            -- A native callback can run while the approaching event yields.
            for _, event in ipairs(context.events) do
                if event ~= target and event.enter and event.section == target.section then return end
            end
            local result = communication.GetFunction("EnterSection"):Invoke(target.section, target.signal)
            if not PlatformRecovery.active(binding, context) then return end
            local response = type(result) == "table" and result.sectionResponse or result
            if response ~= enums.SectionResponse.Accepted and response ~= enums.SectionResponse.NotSignalled then
                PlatformRecovery.stop(context, "arrival returned " .. tostring(response) .. "; no retry")
            end
        end)
        context.busy = false
        if not ok and PlatformRecovery.active(binding, context) then PlatformRecovery.stop(context, tostring(failure)) end
    end)
end
function PlatformRecovery.update()
    local binding = PlatformRecovery.binding
    local context = binding and binding.context
    if not context or context.finished or context.busy or binding.fault then return end
    if not PlatformRecovery.active(binding, context) then PlatformRecovery.cancel(binding, "train state changed"); return end
    if SpadBypass.isSpad(binding.mover) or (SpadBypass.sectionRecovery and SpadBypass.sectionRecovery.busy) then return end
    local target = PlatformRecovery.target(binding, context)
    if not target then return end
    if PlatformRecovery.confirmed(binding, context, target) then
        context.finished = true
        PlatformRecovery.report(context, "success", "Platform occupancy confirmed: " .. target.station .. " " .. target.platform.Name .. ". Passenger loading still requires server approval.")
        local old = context.assigned and target.platform.Parent:FindFirstChild("P" .. tostring(context.assigned))
        local allocation = old and old:FindFirstChild("AllocatedTrain")
        if old ~= target.platform and allocation and allocation.Value == binding.model then
            PlatformRecovery.report(context, "reservation", "Previous platform reservation remains with the server; loading may still be blocked.")
        end
        return
    end
    if PlatformRecovery.claimOccupancy then
        PlatformRecovery.claimArrival(binding, context, target)
        return
    end
    if not context.completeHistory then PlatformRecovery.stop(context, "no acknowledged approach checkpoint; record a fresh approach"); return end
    if PlatformRecovery.waitForPlatform(binding, context, target) then return end
    if target.native and os.clock() - target.native.completedAt < 2 then return end
    if not context.queue or ((context.attempts or 0) == 0 and context.queueEventCount ~= #context.events) then
        local queue, reason, waiting, entered = PlatformRecovery.buildReplay(context, target)
        if not queue then
            if not waiting then PlatformRecovery.stop(context, reason) end
            return
        end
        context.queue, context.initialEntered, context.entered, context.index = queue, entered, table.clone(entered), 1
        context.queueEventCount = #context.events
        if #queue == 0 then PlatformRecovery.stop(context, "server acknowledged this arrival but did not register the platform; no missing crossing to replay"); return end
    end
    if not PlatformRecovery.validated then
        PlatformRecovery.report(context, "validation", "Unregistered diverted arrival identified; correction is awaiting live validation.")
        return
    end
    if os.clock() < context.nextAttempt then return end
    if context.waitUntil then
        if os.clock() < context.waitUntil then return end
        local occupied = target.platform:FindFirstChild("OccupiedTrain")
        if occupied and occupied.Value == binding.model then PlatformRecovery.stop(context, "occupancy registered but assignment is inconsistent; refusing to re-enter the approach"); return end
        if context.attempts >= 3 then PlatformRecovery.stop(context, "server did not register the diverted platform after three corrections"); return end
        context.index, context.entered, context.attemptStarted, context.waitUntil = 1, table.clone(context.initialEntered), false, nil
    end
    context.started = true
    PlatformRecovery.report(context, "started", "Correcting diverted section registration for " .. target.station .. " " .. target.platform.Name .. ".")
    context.nextAttempt, context.busy = os.clock() + 3, true
    task.defer(function()
        local ok, failure = pcall(function()
            local loadModule: any = require
            local communication = loadModule(modules:FindFirstChild("Communication"))
            for _ = 1, 8 do
                if not PlatformRecovery.active(binding, context) then return end
                local current = PlatformRecovery.target(binding, context)
                if not current or current.platform ~= target.platform or SpadBypass.isSpad(binding.mover) then PlatformRecovery.stop(context, "train or platform changed during correction"); return end
                if PlatformRecovery.waitForPlatform(binding, context, target) then return end
                local event = context.queue[context.index]
                if not event then context.waitUntil = os.clock() + 2; return end
                if event.enter and event.signal and not PlatformRecovery.permitted(event.signal) then
                    PlatformRecovery.report(context, "signal", "Platform correction waiting for permission at signal " .. tostring(event.signal) .. ".")
                    return
                end
                if event.enter or context.entered[event.section] then
                    if not context.attemptStarted then context.attempts += 1; context.attemptStarted = true end
                    local result
                    if event.enter then result = communication.GetFunction("EnterSection"):Invoke(event.section, event.signal)
                    else result = communication.GetFunction("ExitSection"):Invoke(event.section) end
                    if not PlatformRecovery.active(binding, context) then return end
                    context.results = context.results or {}
                    table.insert(context.results, { section = event.section, enter = event.enter, response = result })
                    local response = type(result) == "table" and result.sectionResponse or result
                    if response ~= enums.SectionResponse.Accepted and response ~= enums.SectionResponse.NotSignalled then
                        PlatformRecovery.stop(context, "section " .. tostring(event.section) .. " returned " .. tostring(response)); return
                    end
                    if event.enter then
                        context.entered[event.section] = true
                        if type(result) == "table" then
                            for _, junction in ipairs(result.junctionMap or {}) do binding.mover:SetJunctionSetting(junction.junctionId, junction.nodeGroups) end
                        end
                    else context.entered[event.section] = nil end
                end
                context.index += 1
            end
        end)
        context.busy = false
        if not ok and PlatformRecovery.active(binding, context) then PlatformRecovery.stop(context, tostring(failure)) end
    end)
end

local function readyAction(key, interval)
    local now = os.clock()
    if now - (state.lastAction[key] or -math.huge) < interval then return false end
    state.lastAction[key] = now
    return true
end
-- Remote-invoking game callbacks must never block the driving heartbeat.
local function startAction(key, callback, interval)
    if not state.alive or not state.enabled then return false end
    if state.actions[key] or not readyAction(key, interval) then return false end
    local action = { started = os.clock(), warned = false }
    local generation, mover = state.generation, state.mover
    state.actions[key] = action
    action.thread = task.defer(function()
        if not state.alive or not state.enabled or state.generation ~= generation or state.mover ~= mover then
            if state.actions[key] == action then state.actions[key] = nil end
            return
        end
        local ok, err = pcall(callback)
        if state.actions[key] == action then state.actions[key] = nil end
        if state.alive and state.generation == generation then
            if not ok then log(key .. " failed: " .. tostring(err)) end
            if action.warned then log(key .. " finished after a delayed response.") end
        end
    end)
    return true
end
local function releasePowerHold()
    if state.powerReleaseThread then
        local pending = state.powerReleaseThread
        state.powerReleaseThread = nil
        if pending ~= coroutine.running() then pcall(task.cancel, pending) end
    end
    if state.powerHold then pcall(function() state.powerHold:HoldEnd() end); state.powerHold = nil end
end
local function resetTrain(mover)
    if state.mover ~= mover then state.generation += 1 end
    table.clear(callbackCache); emergencyCache = nil
    releasePowerHold()
    state.mover = mover; state.sample = nil
    state.estimate = INITIAL_BRAKING; state.lastDesired = nil
    state.stopSignal = nil
    state.approach = nil
    state.stopTarget = nil; state.bufferCache = nil; state.noseCache = nil; state.stopRest = nil
    state.stopOffset = DEFAULT_STOP_OFFSET; state.undershoot = nil; state.loadingAttempt = nil
    state.responseScale = 0.6
    brakeCurve, zeroBrakeCurve = nil, nil
    state.brakeSamples = {}; state.brakeCalibrated = false; state.fullBrakeSince = nil
    state.lastAction = {}
    state.doorCycle = nil
    state.stationary = nil
end
local function disable(reason)
    state.enabled = false; state.generation += 1
    state.drivingFault = nil
    state.approach = nil
    state.stopTarget = nil
    state.stopOffset = DEFAULT_STOP_OFFSET; state.undershoot = nil; state.loadingAttempt = nil
    state.sample = nil; state.fullBrakeSince = nil
    releasePowerHold()
    if master then master:Set(false, true) end
    setStatus(reason or "Disabled - manual control")
end

local function acknowledgeAws()
    local alert = button("AlertButton")
    if alert and alert.Visible then
        local callback = callbackFor(alert)
        if not callback then error("AWS acknowledgement callback unavailable.") end
        callback()
    end
end
local function powerChoices(mover)
    local electric = { name = "TogglePantograph", power = enums.PowerType.Electric, engine = enums.EngineState.OnElectric,
        available = mover.isOverheadPowerAvailable == true }
    local diesel = { name = "ToggleEngine", power = enums.PowerType.Diesel, engine = enums.EngineState.OnDiesel, available = true }
    local battery = { name = "ToggleBattery", power = enums.PowerType.Battery, engine = enums.EngineState.OnBattery,
        available = type(mover.batteryCharge) == "number" and mover.batteryCharge > 0 }
    if config.mainPower == "Diesel" then return { diesel, electric, battery } end
    return { electric, diesel, battery }
end
-- SHIFT WEBHOOK HELPERS: credentials remain in the user's local webhook setting.
local ShiftWebhook = { enabled=false,disconnectEnabled=false,despawnEnabled=false,pingTarget="",pingMode={"Disconnect webhook"},url="",current=nil,threads={},summarySeen=false }
function ShiftWebhook.clean(value,limit)
    local text=tostring(value or "Unknown"):gsub("[`\r\n]"," "):gsub("@","＠")
    local length=utf8.len(text)
    if not length then return "Unknown" end
    if length>(limit or 80) then text=text:sub(1,utf8.offset(text,(limit or 80)+1)-1) end
    return text
end
function ShiftWebhook.validUrl(value)
    return type(value)=="string" and (value:match("^https://discord%.com/api/webhooks/%d+/[%w_%.%-]+$")
        or value:match("^https://discord%.com/api/v%d+/webhooks/%d+/[%w_%.%-]+$")
        or value:match("^https://discordapp%.com/api/webhooks/%d+/[%w_%.%-]+$"))~=nil
end
function ShiftWebhook.apiUrl(value)
    -- v10 treats attachments as the complete replacement list on message edits.
    local tail=value:match("^https://discord%.com/api/v%d+/(webhooks/.+)$")
        or value:match("^https://discord%.com/api/(webhooks/.+)$")
        or value:match("^https://discordapp%.com/api/(webhooks/.+)$")
    assert(tail,"Invalid webhook URL")
    return "https://discord.com/api/v10/"..tail
end
function ShiftWebhook.number(text)
    return tonumber(tostring(text or ""):gsub(",",""):match("[+-]?%d+%.?%d*"))
end
function ShiftWebhook.clock(timestamp,date)
    if type(timestamp)~="number" or not date then return nil end
    local parts=date.GetDate(timestamp)
    return string.format("%02d:%02d:%02d",parts.hour,parts.min,parts.sec)
end
function ShiftWebhook.gameDate()
    if not board.date then
        local loadGameModule:any=require
        board.date=loadGameModule(game:GetService("ReplicatedStorage").Modules.Date)
    end
    return board.date
end
function ShiftWebhook.delay(value)
    return string.format("+%.2f",math.max(0,value)):gsub("0+$",""):gsub("%.$","").."m"
end
